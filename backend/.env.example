APP_NAME=AgentOS Voz API
ENVIRONMENT=development
# Local/dev: sqlite. Produccion: Postgres real, con Alembic manejando el
# esquema (ver carpeta alembic/ -- "alembic upgrade head" para aplicar
# migraciones, "alembic revision --autogenerate -m '...'" para crear una
# nueva tras cambiar un modelo).
DATABASE_URL=sqlite+aiosqlite:///./agentos.db
# DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/agentos_voz
DEFAULT_TENANT_ID=tenant_demo
LLM_PROVIDER=rule_based
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_PATH_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SIGNATURE=false
TELNYX_API_KEY=
TELNYX_DRY_RUN=false
AGENT_VOICE_LANGUAGE=es-MX
MEDIA_STREAMING_ENABLED=false
PUBLIC_BASE_URL=
DEEPGRAM_API_KEY=
VOICE_AGENT_BRIDGE_ENABLED=false
# api.apiperu.pe: consulta real de DNI (nombre RENIEC) y RUC (razon social
# SUNAT) para la boleta/factura -- ver app/integrations/apiperu_client.py.
# Opcional: sin token, el agente sigue con su fallback de siempre (el
# nombre que dio el cliente / "CLIENTE").
APIPERU_TOKEN=
# Carrito visual durante la llamada (ver docs/08-mejora-carrito-visual-en-llamada.md,
# app/domain/order_review.py). ORDER_REVIEW_SECRET firma el link temporal
# -- sin configurar usa un default de desarrollo, cambiar en produccion.
# FRONTEND_PUBLIC_URL es donde vive /revisar/[token] (Vercel).
ORDER_REVIEW_SECRET=
FRONTEND_PUBLIC_URL=https://agent-os-voz.vercel.app
