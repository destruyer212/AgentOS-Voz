# URL del backend. Solo se usa en el servidor de Next.js (server components /
# server actions), nunca llega al navegador.
API_URL=http://127.0.0.1:8000/api/v1

# Login del panel (ver lib/auth.ts, middleware.ts): 3 roles fijos, sin tabla
# de usuarios. Si se omiten estas variables, se usan los defaults de
# desarrollo local (admin/Olivar2024, cocina/Cocina2024, recepcion/Recepcion2024)
# -- en produccion (Vercel) hay que configurar credenciales propias.
AUTH_SECRET=cambiar-por-un-secreto-largo-y-random-en-produccion
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASS=Olivar2024
AUTH_COCINA_USER=cocina
AUTH_COCINA_PASS=Cocina2024
AUTH_RECEPCION_USER=recepcion
AUTH_RECEPCION_PASS=Recepcion2024
